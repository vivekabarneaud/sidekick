    "build:dev": "npx --yes eas-cli build --profile development --platform android",
    "build:apk": "npx --yes eas-cli build --profile preview --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eas": "^0.1.0",
    "expo": "~57.0.34",
    "expo-background-task": "~57.0.24",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.22",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.32",
    "expo-splash-screen": "~57.0.12",
    "expo-sqlite": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
