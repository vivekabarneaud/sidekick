{
  "expo": {
    "name": "Sidekick",
    "slug": "sidekick",
    "scheme": "sidekick",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.viveka.sidekick",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-splash-screen",
      "./plugins/withPrivacyPolicy.js",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "vivekabarneaud",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "336aa13b-257a-4a9a-8508-91bb82b1110d"
      }
    }
  }
}
